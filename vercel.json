{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "node deploy/build-vercel.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/link.py": {
      "maxDuration": 300,
      "includeFiles": "api/vendor/**",
      "excludeFiles": "{web/**,studio/**,tests/**,node_modules/**,dist/**,artifacts/**,.venv/**}"
    }
  },
  "redirects": [
    { "source": "/login", "destination": "/app", "permanent": false },
    { "source": "/signup", "destination": "/app", "permanent": false },
    { "source": "/reset", "destination": "/get-started", "permanent": false }
  ]
}
